  document.addEventListener('DOMContentLoaded', () => {
   const addToCartButtons = document.querySelectorAll('.add-to-cart-btn');
   addToCartButtons.forEach(button => {
       button.addEventListener('click', addToCart);
   });
});

async function addToCart(event) {
    event.preventDefault();
    const button = event.target;
    const batchId = button.dataset.batchid;

    // Disable the button to prevent multiple clicks while the item is being added to the cart
    button.disabled = true;
    button.innerHTML = 'Adding...'; // Update button text to show adding state

    try {
        const response = await fetch(`/add-to-cart/${batchId}/`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': getCookie('csrftoken') // CSRF Token for security
            },
            body: JSON.stringify({}) // Send empty body since we're just adding an item
        });

        if (!response.ok) {
            throw new Error('Failed to add item to cart. Please try again.');
        }

        const data = await response.json();
        updateCartCount(data.cart_count);
        showCartModal(data.message);

        // Re-enable the button and change its text back
        button.disabled = false;
        button.innerHTML = 'Add to Cart';
    } catch (error) {
        console.error('Error:', error);
        alert('There was an error adding the item to your cart. Please try again.');
        
        // Re-enable the button in case of an error
        button.disabled = false;
        button.innerHTML = 'Add to Cart';
    }
}

function updateCartCount(count) {
    const cartCounts = document.querySelectorAll('.cart-count');
    cartCounts.forEach(element => {
        if (count > 0) {
            element.innerText = count;
            element.style.display = 'inline-block'; // Show the count if there's any item in the cart
        } else {
            element.style.display = 'none'; // Hide the count if no items are in the cart
        }
    });
}

function showCartModal(message) {
    document.getElementById('cartModalMessage').innerText = message;
    $('#cartModal').modal('show');
    setTimeout(() => $('#cartModal').modal('hide'), 3000);
}

function getCookie(name) {
    const cookie = document.cookie.match(`(^|;)\\s*${name}\\s*=\\s*([^;]+)`);
    return cookie ? cookie.pop() : ''; // Return the cookie value if found
}

// Scroll functions for Upcoming Batches
function scrollLeftUpcoming() {
   const scrollContainer = document.getElementById('scroll-container-upcoming');
   scrollContainer.scrollBy({
       left: -400, 
       behavior: 'smooth'
   });
}

function scrollRightUpcoming() {
   const scrollContainer = document.getElementById('scroll-container-upcoming');
   scrollContainer.scrollBy({
       left: 400, 
       behavior: 'smooth'
   });
}

// Scroll functions for Live Batches
function scrollLeftLive() {
   const scrollContainer = document.getElementById('scroll-container-live');
   scrollContainer.scrollBy({
       left: -400, 
       behavior: 'smooth'
   });
}

function scrollRightLive() {
   const scrollContainer = document.getElementById('scroll-container-live');
   scrollContainer.scrollBy({
       left: 400, 
       behavior: 'smooth'
   });
}

// Scroll functions for Test Series
function scrollLeftTest() {
   const scrollContainer = document.getElementById('scroll-container-test');
   scrollContainer.scrollBy({
       left: -400, 
       behavior: 'smooth'
   });
}

function scrollRightTest() {
   const scrollContainer = document.getElementById('scroll-container-test');
   scrollContainer.scrollBy({
       left: 400, 
       behavior: 'smooth'
   });
}

// Check if scrolling is needed for each container
function checkScroll(containerId, leftArrowId, rightArrowId) {
   const container = document.getElementById(containerId);
   const leftArrow = document.getElementById(leftArrowId);
   const rightArrow = document.getElementById(rightArrowId);

   if (container.scrollWidth > container.clientWidth) {
       leftArrow.style.display = 'block';
       rightArrow.style.display = 'block';
   } else {
       leftArrow.style.display = 'none';
       rightArrow.style.display = 'none';
   }
}

// Check scroll for both containers on load and resize
window.onload = function() {
   checkScroll('scroll-container-upcoming', 'left-arrow-upcoming', 'right-arrow-upcoming');
   checkScroll('scroll-container-live', 'left-arrow-live', 'right-arrow-live');
   checkScroll('scroll-container-test', 'left-arrow-test', 'right-arrow-test');
};

window.onresize = function() {
   checkScroll('scroll-container-upcoming', 'left-arrow-upcoming', 'right-arrow-upcoming');
   checkScroll('scroll-container-live', 'left-arrow-live', 'right-arrow-live');
   checkScroll('scroll-container-test', 'left-arrow-test', 'right-arrow-test');
};

</script><!--Start of Tawk.to Script--><!--End of Tawk.to Script--></body></html>