kground-position: center center; } .split-line { border-right: 4px solid #048899; /* Adjust the color and thickness of the line as needed */ height: 100%; } .position-relative h4 { font-size: 48px; font-weight: 600; } .mb-2 { font-size: 18px; } .icon-svg.icon-svg-md { width: 6rem; height: 100%; } .display-4.mb-10.px-xl-10 { font-size: 36px; font-weight: 400; } .display-5.mb-10.px-xl-10 { margin-top: 10%; font-size: 42px; font-weight: 600; color: #0491A3; } .fs-24 { font-size: 1.8rem !important; } .interview-div{ justify-content: center; border-radius: 12px; border: 3px solid #05b5cc; background-color: #e6f8fa; display: flex; gap: 8px; padding: 10px 16px; width: 50%; } .interview-div-2{ color: #036d7a; flex-grow: 1; white-space: nowrap; } .interview-img { aspect-ratio: 1; object-fit: contain; object-position: center; width: 24px; justify-content: center; align-items: center; overflow: hidden; max-width: 100%; } .fs-15.text-uppercase.mb-3 { font-size: 48px !important; font-weight: 600; color: #023F47 !important; } .top_h3 { color: #048899; font-weight: 500; } .card-img-top img { height: 416px !important; border-bottom-left-radius: .4rem; border-bottom-right-radius: .4rem; object-fit: contain; aspect-ratio: 3/2; } .enroll-test-student-dash .card { border: none; /* Remove default card border */ } .enroll-test-student-dash .card-body { padding: 0; /* Remove default padding */ position: relative; /* Set position relative for positioning child elements */ } .enroll-test-student-dash .card-content { position: absolute; /* Position the content overlay */ bottom: 20px; /* Adjust as needed */ left: 10px; /* Adjust as needed */ right: 20px; /* Adjust as needed */ background-color: rgba(0, 0, 0, 0); /* Semi-transparent background color */ padding: 10px; /* Padding for content */ border-radius: 10px; /* Rounded corners */ top: 25px; width: 70%; } .graph_title { text-align: center; font-size: 25px; color: #023f47; } .enroll-test-student-dash .card-content h5 { color: #fff; /* Text