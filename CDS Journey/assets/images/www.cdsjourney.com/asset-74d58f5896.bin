r: #fff;} to {color: #ca040c;} } @keyframes mymove { from {color: cyan;} to {color: #ca040c;} } .nav1 { margin:0 auto; position: -webkit-sticky; position:sticky; } .nav1 { color: #fff; margin: 5px 0; text-align:right; width: 100%; } .nav-link { margin-top: 4px; padding:0!important; } .navbar-expand-lg .navbar-nav { flex-direction: row; float: right; } .navbar-brand { margin-right:5px; } .card-content-original { position: absolute; top: 25%; justify-content: center; display: flex; flex-direction: column; flex-wrap: nowrap; } /* .top-bar li:nth-child(even){ background: #27b999; } .top-bar li:nth-child(odd){ background:#8f72ff; } */ .top-bar li { display: inline-block; margin-right: 10px; border-radius:2px; font-weight: 600; } .top-bar ul{ margin: 0 0 0px; } li.nav-item { padding-top: 10px; display: inline-block; } .top-bar li a{ color:#fff; padding:14px 10px 0; } .top-bar li a:hover{ color:#000; } .top-bar li { font-size: 0.8rem; font-weight: 600; } a.nav-link { padding-left: .5rem !important; padding-right: .5rem !important; } /* overlay css */ .overlay { /* Height & width depends on how you want to reveal the overlay (see JS below) */ height: 100%; width: 0; position: fixed; /* Stay in place */ z-index: 1000 !important; /* Sit on top */ left: 0; top: 0; background-color: rgb(0,0,0); /* Black fallback color */ background-color: rgba(0,0,0, 0.9); /* Black w/opacity */ overflow-x: hidden; /* Disable horizontal scroll */ transition: 0.5s; /* 0.5 second transition effect to slide in or slide down the overlay (height or width, depending on reveal) */ } /* Position the content inside the overlay */ .overlay-content { position: relative; top: 25%; /* 25% from the top */ width: 100%; /* 100% width */ text-align: center; /* Centered text/links */ margin-top: 30px; /* 30px top margin to avoid conflict with the close button on smaller screens */ } /* The navigation links inside the overlay */ .overlay { height: 0%; width: 100%; position: fixed; z-index: 1; top: 50; left: 0; background-color: rgb(0,0,0); background-color: rgba(0,0,0, 0.9); overflow-y: hidden; transition: 0.5s; } .overlay-content { position: relative; display: block; overflow-y: auto; overflow-x: hidden; top: 0; width: 96%; max-height: 75vh; text-align: left; margin-top: 30px; margin-left: 30px; } .overlay a { text-decoration: none; font-size: 30px; color: #818181; display: block; transition: 0.3s; } .overlay a:hover, .overlay a:focus { color: #f1f1f1; } .overlay .closebtn { position: absolute; top: 82px; right: 0; font-size: 60px; } @media screen and (max-height: 450px) { .overlay {overflow-y: auto;} .overlay a {font-size: 20px} .overlay .closebtn { font-size: 40px; top: 15px; right: 35px; } } #input-example { width: 100%; height: 33px; color: #000 !important; margin-left: 25px; font-size: x-large; padding: 26px 65px 26px; border-radius: 50px; } .search-here{ color: #333 !important; } .smallname a{ display: contents !important; font-size: 18px !important; margin-left: 15px !important; } .overlay-content hr{ margin: 0px 5px 0px 0px !important; } .close-btn{ font-size: xx-large; background: blue; width: 50px; height: 50px; border-radius: 50%; position: relative; } .clse{ position: absolute; top: -3px; right: 17px; } input:focus-visible { outline: 0px; border:none; } input:focus-visible::placeholder{ color:#fff; } .course-name{ padding-top:5px; } .course-name a{ font-size:16px; } .exm-img{} .exm-img img{ display:block; margin:5px auto; width:50px; height:50px; padding:4px; background:#fff; border-radius:50%; } hr:not([size]) { height: 0.1px; opacity: 0.3; } .hr-brd{ border:1px solid #ccc; } .serch-bar img{ position:absolute; left:40px; padding:1px 1px 0; } .progress-wrap svg.progress-circle path { stroke: #128897; } .exmpur-login-modal .form-control { display: block; width: 100%; padding: 0.6rem 1rem; font-size: .75rem; font-weight: 500; line-height: 1.7; color: #60697b; background-clip: padding-box; -webkit-appearance: none; -moz-appearance: none; appearance: none; box-shado