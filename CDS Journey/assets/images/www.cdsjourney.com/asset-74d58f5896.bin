    // TODO: Replace with your Firebase config
    const firebaseConfig = {
    apiKey: "AIzaSyD4T4dFvDL09NaLvzFv-c0xYmg-If8mMKI",
    authDomain: "cdsjourney-9a1e8.firebaseapp.com",
    projectId: "cdsjourney-9a1e8",
    storageBucket: "cdsjourney-9a1e8.appspot.com",
    messagingSenderId: "939307199679",
    appId: "1:939307199679:web:976ba22407d948c2296a0a",
    measurementId: "G-8VYZEW9RDE"
  };
    // Initialize Firebase

    firebase.initializeApp(firebaseConfig);
    const messaging = firebase.messaging();


    // Request permission to send notifications
    function requestPermissionAndUpdateToken() {
      messaging.requestPermission()
        .then(() => {
          console.log('Notification permission granted.');
          return messaging.getToken();
        })
        .then((token) => {
          console.log('Device token:', token);
          updateDeviceToken(token);
        })
        .catch((err) => {
          console.log('Unable to get permission to notify.', err);
        });
    }

    toastr.options = {
  "closeButton": true,
  "debug": false,
  "newestOnTop": false,
  "progressBar": true,
  "positionClass": "toast-top-center",
  "preventDuplicates": false,
  "onclick": null,
  "showDuration": "300",
  "hideDuration": "1000",
  "timeOut": "5000",
  "extendedTimeOut": "1000",
  "showEasing": "swing",
  "hideEasing": "linear",
  "showMethod": "fadeIn",
  "hideMethod": "fadeOut"
};

      
// Handle incoming messages when the app is in foreground
messaging.onMessage((payload) => {
  console.log('Message received. ', payload);
  
  // Extract the title, image, and message body from the payload
  const title = payload.notification.title;
  const message = payload.notification.body || '';
  const image = payload.notification.image;

  // Display notification using Toastr
  if (image) {
    toastr.success(`
        <div style="display: flex; align-items: center;">
            <img src="${image}" style="width: 50px; height: 50px; margin-right: 10px;">
            <div>
                <strong>${title}</strong><br>
                ${message}
            </div>
        </div>
    `);
} else {
    toastr.success(`
        <div>
            <strong>${title}</strong><br>
            ${message}
        </div>
    `);
}
});

    function updateDeviceToken(token) {
      fetch("/update_device_token/", {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRFToken': 'hlJsEKbefp8ZylLghKtly42i6OZFyoGyCFsZqH0QCeynk2JywEBcVbD9qQLoXkR7',
        },
        body: JSON.stringify({ device_token: token })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          console.log('Device token updated successfully');
        } else {
          console.error('Failed to update device token:', data.error);
        }
      })
      .catch(error => {
        console.error('Error:', error);
      });
    }
    document.addEventListener('DOMContentLoaded', (event) => {
        
      });
  
  </script><div class="content-wrapper"><style>/* General styles for the navigation bar */ .nav-item { position: relative; display: inline-block; } /* Style for the Mock Test link (Main Menu Item) */ .nav-link { color: #333; text-decoration: none; font-weight: 500; padding: 10px 15px; cursor: pointer; position: relative; border-radius: 5px; } /* Hover effect for the Mock Test link (Main Menu) */ .nav-item#mockTestItem:hover .nav-link { background-color: #91a1b3; /* Gray background on hover for Mock Test */ color: white; /* Change text color to white when hovered */ border-radius: 5px; /* Maintain rounded corners */ } /* Dropdown menu styles */ .dropdown-menu { display: none; /* Initially hidden */ position: absolute; background-color: #fff; box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.1); min-width: 160px; z-index: 1; margin-top: 5px; border-radius: 5px; } /* Show the dropdown menu when hovering over the Mock Test link or the menu itself */ .nav-item#mockTestItem:hover .dropdown-menu { display: block; } /* Dropdown item styles */ .dropdown-item { color: #333; padding: 12px 16px; text-decoration: none; display: block; border-bottom: 1px solid #f1f1f1; cursor: pointer; } .dropdown-item:last-child { border-bottom: none; } /* Hover effect for dropdown items */ .dropdown-item:hover { background-color: #007bff; /* Blue background */ color: white; border-radius: 5px; } /* Make sure the dropdown stays open when hovering over the dropdown menu */ .nav-item#mockTestItem:hover .dropdown-menu:hover { display: block; } .all-exam-catg{ width:39rem; background:#ffff; margin-top:-8px; border-radius:.4rem; height:340px; overflow:auto; margin-bottom:-10px; } /* total width */ .scrollbar::-webkit-scrollbar { background-color:#fff; width:16px } /* background of the scrollbar except button or resizer */ .scrollbar::-webkit-scrollbar-track { background-color:#fff } .scrollbar::-webkit-scrollbar-track:hover { background-color:#f4f4f4 } /* scrollbar itself */ .scrollbar::-webkit-scrollbar-thum